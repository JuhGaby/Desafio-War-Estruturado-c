#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

// Definição da struct Territorio
// Esta estrutura armazena informações sobre cada território
struct Territorio {
    char nome[30];      // Nome do território (máx 29 caracteres + \0)
    char cor[10];       // Cor do exército (máx 9 caracteres + \0)
    int tropas;         // Quantidade de tropas no território
};

// Protótipos das funções
void cadastrarTerritorios(struct Territorio* mapa, int quantidade);
void exibirTerritorios(struct Territorio* mapa, int quantidade);
void atacar(struct Territorio* atacante, struct Territorio* defensor);
void liberarMemoria(struct Territorio* mapa);
int validarAtaque(struct Territorio* atacante, struct Territorio* defensor);

int main() {
    // Inicializa o gerador de números aleatórios
    srand(time(NULL));
    
    int quantidade;
    
    printf("=== SISTEMA DE GUERRA ESTRUTURADO ===\n\n");
    
    // Solicita a quantidade de territórios
    printf("Digite a quantidade de territorios a serem cadastrados: ");
    scanf("%d", &quantidade);
    
    // Limpa o buffer do teclado
    while (getchar() != '\n');
    
    // Alocação dinâmica de memória para o vetor de territórios
    struct Territorio* mapa = (struct Territorio*)calloc(quantidade, sizeof(struct Territorio));
    
    // Verifica se a alocação foi bem sucedida
    if (mapa == NULL) {
        printf("Erro: nao foi possivel alocar memoria!\n");
        return 1;
    }
    
    // Cadastro dos territórios
    cadastrarTerritorios(mapa, quantidade);
    
    // Exibe os territórios cadastrados
    printf("\n");
    exibirTerritorios(mapa, quantidade);
    
    // Sistema de ataques
    int continuar = 1;
    while (continuar) {
        printf("\n=== SISTEMA DE ATAQUE ===\n");
        
        // Exibe os territórios disponíveis para referência
        exibirTerritorios(mapa, quantidade);
        
        int indiceAtacante, indiceDefensor;
        
        // Seleção do território atacante
        printf("\nSelecione o territorio ATACANTE (digite o numero): ");
        scanf("%d", &indiceAtacante);
        indiceAtacante--; // Ajusta para índice do vetor (0-based)
        
        // Valida o índice do atacante
        if (indiceAtacante < 0 || indiceAtacante >= quantidade) {
            printf("Erro: territorio atacante invalido!\n");
            continue;
        }
        
        // Seleção do território defensor
        printf("Selecione o territorio DEFENSOR (digite o numero): ");
        scanf("%d", &indiceDefensor);
        indiceDefensor--; // Ajusta para índice do vetor (0-based)
        
        // Valida o índice do defensor
        if (indiceDefensor < 0 || indiceDefensor >= quantidade) {
            printf("Erro: territorio defensor invalido!\n");
            continue;
        }
        
        // Valida se o ataque é possível
        if (!validarAtaque(&mapa[indiceAtacante], &mapa[indiceDefensor])) {
            printf("Ataque invalido! Verifique as regras.\n");
            continue;
        }
        
        // Executa o ataque
        printf("\n=== INICIANDO ATAQUE ===\n");
        printf("%s (%s) ataca %s (%s)\n", 
               mapa[indiceAtacante].nome, mapa[indiceAtacante].cor,
               mapa[indiceDefensor].nome, mapa[indiceDefensor].cor);
        
        atacar(&mapa[indiceAtacante], &mapa[indiceDefensor]);
        
        // Exibe o resultado
        printf("\n=== RESULTADO DO ATAQUE ===\n");
        exibirTerritorios(mapa, quantidade);
        
        // Pergunta se deseja continuar
        printf("\nDeseja realizar outro ataque? (1 - Sim, 0 - Nao): ");
        scanf("%d", &continuar);
        
        // Limpa o buffer do teclado
        while (getchar() != '\n');
    }
    
    // Libera a memória alocada
    liberarMemoria(mapa);
    
    printf("\nJogo encerrado. Obrigado por jogar!\n");
    
    return 0;
}

/**
 * Função para cadastrar os territórios
 * @param mapa Ponteiro para o vetor de territórios
 * @param quantidade Quantidade total de territórios
 */
void cadastrarTerritorios(struct Territorio* mapa, int quantidade) {
    printf("\n=== CADASTRO DE TERRITORIOS ===\n");
    
    for (int i = 0; i < quantidade; i++) {
        printf("\n--- Territorio %d ---\n", i + 1);
        
        // Leitura do nome do território
        printf("Digite o nome do territorio: ");
        scanf("%29s", mapa[i].nome);
        
        // Leitura da cor do exército
        printf("Digite a cor do exercito: ");
        scanf("%9s", mapa[i].cor);
        
        // Leitura da quantidade de tropas
        printf("Digite a quantidade de tropas: ");
        scanf("%d", &mapa[i].tropas);
        
        // Limpa o buffer do teclado
        while (getchar() != '\n');
    }
}

/**
 * Função para exibir todos os territórios
 * @param mapa Ponteiro para o vetor de territórios
 * @param quantidade Quantidade total de territórios
 */
void exibirTerritorios(struct Territorio* mapa, int quantidade) {
    printf("\n=== TERRITORIOS CADASTRADOS ===\n");
    printf("================================\n");
    
    for (int i = 0; i < quantidade; i++) {
        printf("%d. Nome: %-15s | Cor: %-10s | Tropas: %d\n", 
               i + 1, mapa[i].nome, mapa[i].cor, mapa[i].tropas);
    }
    printf("================================\n");
}

/**
 * Função para validar se um ataque é possível
 * @param atacante Ponteiro para o território atacante
 * @param defensor Ponteiro para o território defensor
 * @return 1 se o ataque é válido, 0 caso contrário
 */
int validarAtaque(struct Territorio* atacante, struct Territorio* defensor) {
    // Não pode atacar o próprio território
    if (atacante == defensor) {
        printf("Erro: nao pode atacar o proprio territorio!\n");
        return 0;
    }
    
    // Não pode atacar território da mesma cor
    if (strcmp(atacante->cor, defensor->cor) == 0) {
        printf("Erro: nao pode atacar territorio da mesma cor (%s)!\n", atacante->cor);
        return 0;
    }
    
    // Atacante deve ter pelo menos 2 tropas (1 para atacar e 1 para manter o território)
    if (atacante->tropas < 2) {
        printf("Erro: territorio atacante precisa de pelo menos 2 tropas!\n");
        return 0;
    }
    
    // Defensor deve ter pelo menos 1 tropa
    if (defensor->tropas < 1) {
        printf("Erro: territorio defensor nao tem tropas para defender!\n");
        return 0;
    }
    
    return 1;
}

/**
 * Função que simula um ataque entre dois territórios
 * @param atacante Ponteiro para o território atacante
 * @param defensor Ponteiro para o território defensor
 */
void atacar(struct Territorio* atacante, struct Territorio* defensor) {
    // Simula a rolagem de dados (1-6) para atacante e defensor
    int dadoAtacante = (rand() % 6) + 1;
    int dadoDefensor = (rand() % 6) + 1;
    
    printf("Dado do atacante: %d\n", dadoAtacante);
    printf("Dado do defensor: %d\n", dadoDefensor);
    
    // Determina o vencedor do confronto
    if (dadoAtacante > dadoDefensor) {
        // Atacante vence
        printf("\n>>> VITORIA DO ATACANTE! <<<\n");
        
        // Calcula tropas capturadas (metade das tropas do defensor, mínimo 1)
        int tropasCapturadas = defensor->tropas / 2;
        if (tropasCapturadas < 1) {
            tropasCapturadas = 1;
        }
        
        // Atualiza o território conquistado
        strcpy(defensor->cor, atacante->cor);  // Muda a cor para a do atacante
        defensor->tropas = tropasCapturadas;   // Define novas tropas
        
        // Atacante perde 1 tropa no processo
        atacante->tropas--;
        
        printf("O territorio %s foi conquistado por %s!\n", defensor->nome, atacante->cor);
        printf("Tropas capturadas: %d\n", tropasCapturadas);
        
    } else {
        // Defensor vence ou empate (defensor ganha em caso de empate)
        printf("\n>>> VITORIA DO DEFENSOR! <<<\n");
        
        // Defensor perde 1 tropa
        defensor->tropas--;
        
        // Atacante perde 1 tropa
        atacante->tropas--;
        
        printf("O ataque foi repelido! Ambas as partes perderam 1 tropa.\n");
    }
    
    // Remove territórios sem tropas
    if (atacante->tropas <= 0) {
        printf("ALERTA: %s ficou sem tropas!\n", atacante->nome);
        atacante->tropas = 0;
    }
    
    if (defensor->tropas <= 0) {
        printf("ALERTA: %s ficou sem tropas!\n", defensor->nome);
        defensor->tropas = 0;
    }
}

/**
 * Função para liberar a memória alocada
 * @param mapa Ponteiro para o vetor de territórios
 */
void liberarMemoria(struct Territorio* mapa) {
    free(mapa);
    printf("Memoria liberada com sucesso.\n");
}